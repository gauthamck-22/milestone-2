{
  "info": {
    "name": "Digital Healthcare Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register Patient",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Patient Sara Lee\",\n  \"email\": \"sara@healthcare.test\",\n  \"password\": \"Patient123\"\n}"
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sara@healthcare.test\",\n  \"password\": \"Patient123\"\n}"
        }
      }
    },
    {
      "name": "Get Profile",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/api/users/me", "host": ["{{baseUrl}}"], "path": ["api", "users", "me"] }
      }
    },
    {
      "name": "Book Appointment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/appointments", "host": ["{{baseUrl}}"], "path": ["api", "appointments"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clinician\": \"{{clinicianId}}\",\n  \"start\": \"2026-06-05T09:00:00.000Z\",\n  \"end\": \"2026-06-05T09:30:00.000Z\",\n  \"notes\": \"Follow-up visit\"\n}"
        }
      }
    },
    {
      "name": "Create EMR Record",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{clinicianToken}}" }
        ],
        "url": { "raw": "{{baseUrl}}/api/emr", "host": ["{{baseUrl}}"], "path": ["api", "emr"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patient\": \"{{patientId}}\",\n  \"visitNotes\": \"Patient reports mild headache.\",\n  \"diagnosis\": \"Tension headache\",\n  \"medications\": [{ \"title\": \"Ibuprofen\", \"details\": \"400mg, twice daily\" }]\n}"
        }
      }
    }
  ]
}
